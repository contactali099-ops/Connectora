# GEMINI_API_KEY: Required if server-side Gemini AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL of the deployed application.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT CONFIGURATION (Public browser-safe values only)
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend or VITE_* environment variables.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-supabase-anon-key"
